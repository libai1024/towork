#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
python3 tool/check_size_baseline.py
python3 - <<'PY'
import os
import subprocess
paths = subprocess.check_output([
    'git', 'diff', '--cached', '--name-only', '-z', '--diff-filter=ACMR', '--', '*.dart',
]).decode().split('\0')
paths = [path for path in paths if path]
if paths:
    subprocess.run([os.environ.get('DART_BIN', 'dart'), 'format', '--output=none',
                    '--set-exit-if-changed', *paths], check=True)
PY
