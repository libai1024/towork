      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"provider_configurations\" (\"id\" INTEGER NOT NULL, \"product\" TEXT NOT NULL, \"region\" TEXT NOT NULL, \"model\" TEXT NOT NULL, \"disable_thinking\" INTEGER NOT NULL CHECK (\"disable_thinking\" IN (0, 1)), \"version\" INTEGER NOT NULL, \"credential_ref\" TEXT NULL, PRIMARY KEY (\"id\"));"
