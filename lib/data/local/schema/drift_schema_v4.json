          "sql": "CREATE TABLE IF NOT EXISTS \"local_profiles\" (\"singleton_id\" INTEGER NOT NULL, \"local_user_id\" TEXT NOT NULL UNIQUE, \"nickname\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"singleton_id\"));"
