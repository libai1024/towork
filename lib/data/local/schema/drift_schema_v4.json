          "sql": "CREATE TABLE IF NOT EXISTS \"work_categories\" (\"id\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"parent_id\" TEXT NULL, \"archived\" INTEGER NOT NULL CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
